{
    "name": "teamones/phpcent",
    "description": "Centrifugo 3.x HTTP API client with PHP 8.5 and Workerman 5 support",
    "keywords": [
        "centrifugo",
        "websocket",
        "realtime",
        "messaging"
    ],
    "homepage": "https://github.com/teamones-open/phpcent",
    "version": "5.0.1",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.34",
        "workerman/http-client": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "phpcent\\": "src"
        }
    },
    "conflict": {
        "centrifugal/phpcent": "*"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:integration": "@php -d error_reporting=30719 integration/centrifugo3.php"
    },
    "suggest": {
        "workerman/http-client": "^3.1 for optional asynchronous requests inside Workerman 5"
    }
}
